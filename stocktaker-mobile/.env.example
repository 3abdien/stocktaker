# Where the Stocktaker API is reachable FROM THE PHONE. "localhost" means
# the phone itself, not your computer, so use your computer's LAN IP here
# and start the API with `uvicorn app.main:app --host 0.0.0.0 --reload`.
#
# Leave unset during development to auto-detect: the app reuses the host
# of the Expo dev server it was loaded from, on port 8000.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:8000
