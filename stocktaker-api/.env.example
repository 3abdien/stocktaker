# Copy to .env and adjust for local development.
# In production (Render/Railway/etc.) set these as real environment
# variables in the platform's dashboard instead of shipping a .env file.

# SQLite (default) needs nothing here. For Postgres:
# DATABASE_URL=postgresql://user:password@host:5432/stocktaker
DATABASE_URL=sqlite:///./stocktaker.db

# MUST be overridden to a long random value in production - anyone who
# knows this secret can forge access tokens.
JWT_SECRET=dev-only-do-not-use-in-production

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Password for the `admin` account created on first startup. Set this on
# any public deploy - the default is only for local development.
# INITIAL_ADMIN_PASSWORD=admin123

# Combined deploy only (see ../Dockerfile and ../render.yaml): serve the
# API under /api and the built web dashboard at /. Leave unset locally.
# API_PREFIX=/api
# WEB_DIST_DIR=/srv/web

# Comma-separated origins allowed to call this API (your web dashboard's
# URL, and your Expo dev server for the mobile app during development).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:19006
